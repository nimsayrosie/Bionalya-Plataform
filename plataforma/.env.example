# Bionalya — variáveis para rodar na sua máquina.
# Copie para plataforma/.env e preencha. O .env não sobe para o GitHub.
# Na hospedagem (Render), as mesmas variáveis vão no painel, em Environment.
# Onde achar cada valor: docs/banco-e-hospedagem.md

# --- Supabase: login --------------------------------------------------------
# Painel do projeto > Project Settings > API Keys (ou Data API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Chave secreta (service_role / secret). Só no servidor, nunca no navegador.
SUPABASE_SERVICE_KEY=

# --- Supabase: banco ----------------------------------------------------------
# Em branco = SQLite local (plataforma/bionalya.db).
# Para usar o banco do Supabase: botão "Connect" > "Session pooler".
# DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# --- Endereço do site (vai nos links dos e-mails) -----------------------------
SITE_URL=http://127.0.0.1:8000

# --- E-mail (Gmail) -----------------------------------------------------------
# Conta Gmail do projeto, com verificação em duas etapas e uma "senha de app"
# (myaccount.google.com/apppasswords). Não é a senha da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_NOME=Bionalya

# --- Conta de admin -----------------------------------------------------------
# Use um e-mail que exista: é para ele que vai o link de senha nova.
BIONALYA_ADMIN_EMAIL=
# Em branco = a API sorteia na primeira vez e grava em PRIMEIRO-ACESSO.txt.
BIONALYA_ADMIN_SENHA=

# --- Só para rodar supabase/configurar.py -------------------------------------
# Token pessoal: supabase.com/dashboard/account/tokens. Dá acesso a todos os
# seus projetos: fica só aqui, nunca no Render.
SUPABASE_ACCESS_TOKEN=
